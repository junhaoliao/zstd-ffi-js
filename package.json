{
  "name": "@yscope/zstd-ffi-js",
  "version": "0.0.1",
  "description": "A Zstandard library for JavaScript/TypeScript with decompression support and future compression support",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./decompressor": {
      "import": "./dist/decompressor/index.js",
      "types": "./dist/decompressor/index.d.ts"
    }
  },
  "files": [
    "dist/**",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "task package",
    "build:zstd": "task zstd-ffi-js",
    "build:ts": "tsc",
    "build:all": "task zstd-ffi-js && tsc",
    "clean": "task clean",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run --coverage",
    "release": "git diff --exit-code && task package && npm publish"
  },
  "author": "YScope Inc. <dev@yscope.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/y-scope/zstd-ffi-js#readme",
  "bugs": {
    "url": "https://github.com/y-scope/zstd-ffi-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y-scope/zstd-ffi-js.git"
  },
  "keywords": [
    "zstd",
    "zstandard",
    "wasm",
    "webassembly",
    "decompression"
  ],
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint-config-yscope": "1.1.1",
    "tar": "^7.4.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.2.4"
  }
}
